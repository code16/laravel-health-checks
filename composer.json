{
    "name": "code16/laravel-health-checks",
    "description": "Various checks for spatie/laravel-health",
    "keywords": [
        "Code 16",
        "laravel",
        "laravel-health-checks"
    ],
    "homepage": "https://github.com/code16/laravel-health-checks",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucien PUGET",
            "email": "lucien.puget@code16.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0"
    },
    "require-dev": {
        "code16/pint-config": "^1.2",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-health": "^1.37"
    },
    "autoload": {
        "psr-4": {
            "Code16\\LaravelHealthChecks\\": "src/",
            "Code16\\LaravelHealthChecks\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Code16\\LaravelHealthChecks\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@composer run prepare",
            "@php vendor/bin/pint-config install"
        ],
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Code16\\LaravelHealthChecks\\LaravelHealthChecksServiceProvider"
            ],
            "aliases": {
                "LaravelHealthChecks": "Code16\\LaravelHealthChecks\\Facades\\LaravelHealthChecks"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
